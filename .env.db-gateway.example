# ===== DB Gateway HTTP API =====
# 这个 key 用于保护 /db-gateway/query 和 /db-gateway/status。
# zd-agent 的 /opt/zd-agent/.env 里 DB_GATEWAY_API_KEY 必须与这里一致。
DB_GATEWAY_API_KEY=
DB_GATEWAY_LISTEN_HOST=127.0.0.1
DB_GATEWAY_LISTEN_PORT=18081

# ===== PostgreSQL via Teleport proxy =====
# 通常不需要填 — DB Gateway 本机通过 Teleport `tsh proxy db` 走证书认证，psql 不需要密码。
# 仅在以下场景才需要填：
#   - 不走 Teleport，直连 DB（config.yaml 里 postgres.host 改为 DB 地址）
#   - Teleport 代理后 DB 仍要求密码（双重认证，极少见）
PG_PASSWORD=

# ===== Teleport =====
TELEPORT_USER=
# 续期页面公网地址，例如 https://agent.example.com
TELEPORT_PUBLIC_BASE_URL=

# 自动续期凭证；任一为空则退回飞书手动续期卡片。
TELEPORT_PASSWORD=
TELEPORT_TOTP_SECRET=

# watchdog 调 /internal/teleport-auth/issue 时的共享 secret。
# 任意强随机字符串（> 32 字符），部署时生成一次。
INTERNAL_SHARED_SECRET=

# ===== Feishu alerting for watchdog =====
# 用于 Teleport 续期失败 / 手动续期卡片推送。
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
