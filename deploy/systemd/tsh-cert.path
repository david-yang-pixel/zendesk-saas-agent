[Unit]
Description=Watch Teleport user cert file; trigger proxy restart on renewal
After=tsh-auth-watchdog.service

[Path]
# 只监视主用户 cert 文件（不是整个 keys 目录！）
# 之前监视整个 keys/teleport.dify.dev 目录会**误触发**：
#   tsh proxy db 启动时会在 keys/teleport.dify.dev/yangyonggang-db/
#   下生成 db-specific cert，让目录 mtime 变 → path-unit 触发
#   restart-proxies → tsh proxy db 再启动 → 又生成 db cert → 无限循环
# 用户 cert 主文件（yangyonggang.crt）只在 tsh login 时更新，是正确信号。
PathChanged=/opt/zd-agent/.tsh/keys/teleport.dify.dev/yangyonggang.crt
# debounce: 5s 内至少 1 次（tsh login 一气呵成写完所有文件）
TriggerLimitIntervalSec=5s
TriggerLimitBurst=1

Unit=tsh-restart-proxies.service

[Install]
WantedBy=multi-user.target
