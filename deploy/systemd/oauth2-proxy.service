[Unit]
Description=oauth2-proxy for zd-agent log viewer (Google login, @dify.ai only)
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
# 三个密钥（OAUTH2_PROXY_CLIENT_ID / _CLIENT_SECRET / _COOKIE_SECRET）放在
# /opt/zd-agent/oauth2-proxy.env（chmod 600，不进 git）。运维人本人创建。
EnvironmentFile=/opt/zd-agent/oauth2-proxy.env
# OAuth token 交换要主动连 googleapis.com（境外被墙）→ 走 clash 代理。
# NO_PROXY 排除本地，避免回调/healthcheck 等本机流量也被代理。
Environment=HTTPS_PROXY=http://127.0.0.1:7890
Environment=HTTP_PROXY=http://127.0.0.1:7890
Environment=NO_PROXY=localhost,127.0.0.1,zendesk.smlershou.top
ExecStart=/usr/local/bin/oauth2-proxy \
  --provider=google \
  --email-domain=dify.ai \
  --http-address=127.0.0.1:4180 \
  --redirect-url=https://zendesk.smlershou.top/oauth2/callback \
  --cookie-secure=true \
  --reverse-proxy=true \
  --whitelist-domain=zendesk.smlershou.top \
  --custom-templates-dir=/opt/zd-agent/oauth2-proxy-templates \
  --upstream=static://200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
