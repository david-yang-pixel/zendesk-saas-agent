[Unit]
Description=Restart 3 tsh-proxy-db services after cert renewal
# Triggered by tsh-cert.path; do not start manually unless debugging.

[Service]
Type=oneshot
# tsh login 续期会在几秒内连续写多个 cert 文件（yangyonggang / .crt / .key / .pub /
# certs.pem / current-profile / yangyonggang-db/...）每个 fs 事件都触发一次
# tsh-cert.path → 多次进来抢 restart，proxy 进程被反复 kill 进 crashloop。
# 用 flock 串行化：第一次执行的拿到锁，剩下的瞬时被拒（exit 1，按 success 处理）。
# 锁内 sleep 8 等所有 cert 文件 settle 之后再 restart，确保 proxy 用最终态 cert。
ExecStart=/usr/bin/flock -n /var/lock/tsh-restart.lock /bin/sh -c '\
    sleep 8; \
    systemctl restart tsh-proxy-db tsh-proxy-db-billing tsh-proxy-db-plugin; \
    echo "[$$(date -Iseconds)] proxies restarted via path-trigger" >> /var/log/tsh-cert-restarts.log; \
'
# flock -n 抢不到锁时 exit 1 → 视作成功（这是预期）
SuccessExitStatus=0 1
