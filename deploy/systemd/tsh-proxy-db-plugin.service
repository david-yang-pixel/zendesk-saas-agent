[Unit]
Description=Teleport proxy db for zd-agent (plugin_daemon, localhost:56063)
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=30
User=zd-agent

Environment="TELEPORT_HOME=/opt/zd-agent/.tsh"

ExecStart=/usr/local/bin/tsh proxy db --tunnel \
    --db-user=pro_ops_teleport_read \
    --db-name=dify_plugin_daemon \
    --port=56063 \
    lg-pgsql-read-01

[Install]
WantedBy=multi-user.target
