[Unit]
Description=Run proxy-health probe every 2 minutes
After=tsh-proxy-db.service tsh-proxy-db-billing.service tsh-proxy-db-plugin.service

[Timer]
# 启动后 30s 第一次跑（让 proxies 完全 ready）
OnBootSec=30s
# 之后每 2 分钟跑一次
OnUnitActiveSec=2min
AccuracySec=10s
Unit=proxy-health.service

[Install]
WantedBy=timers.target
