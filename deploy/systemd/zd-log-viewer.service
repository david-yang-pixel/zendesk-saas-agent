[Unit]
Description=zd-agent log viewer (read-only jsonl web UI)
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
WorkingDirectory=/opt/zd-agent/log-viewer
Environment=ZD_LOG_DIR=/opt/zd-agent/logs
# 0 = 读取全部历史日志（jsonl 始终不删）。设成 N 则只读最近 N 天。
Environment=ZD_LOG_DAYS=0
Environment=ZD_AGENT_CONFIG_PATH=/opt/zd-agent/code/config.yaml
Environment=ZD_AGENT_ENV_PATH=/opt/zd-agent/.env
Environment=ZD_AGENT_CONTROL_PATH=/opt/zd-agent/resources/.state/control.json
Environment=ZD_AGENT_AUDIT_PATH=/opt/zd-agent/logs/admin-audit.jsonl
Environment=ZD_AGENT_SERVICE=zd-agent
ExecStart=/opt/zd-agent/log-viewer/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8081
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
