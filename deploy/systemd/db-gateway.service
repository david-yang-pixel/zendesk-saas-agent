[Unit]
Description=DB Gateway for zd-agent (Teleport, DB proxy, read-only SQL API)
After=docker.service network-online.target tsh-proxy-db.service tsh-proxy-db-billing.service tsh-proxy-db-plugin.service
Requires=docker.service
Wants=tsh-proxy-db.service tsh-proxy-db-billing.service tsh-proxy-db-plugin.service

[Service]
Type=simple
Restart=always
RestartSec=30

ExecStartPre=-/usr/bin/docker rm -f db-gateway
ExecStart=/usr/bin/docker run --rm --name db-gateway \
    --network host \
    -v /opt/zd-agent/resources:/opt/zd-agent/resources \
    -v /opt/zd-agent/logs:/opt/zd-agent/logs \
    -v /opt/db-gateway/.env:/app/.env:ro \
    -v /opt/zd-agent/code/config.yaml:/app/config.yaml:ro \
    -v /opt/zd-agent/.tsh:/opt/zd-agent/.tsh \
    -v /usr/local/bin/tsh:/usr/local/bin/tsh:ro \
    -e HOST_TSH_UID=998 -e HOST_TSH_GID=997 \
    --memory=256m --cpus=0.3 \
    --log-driver=journald \
    zd-agent:latest \
    uv run zd-agent db-gateway

ExecStop=/usr/bin/docker stop -t 15 db-gateway
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
