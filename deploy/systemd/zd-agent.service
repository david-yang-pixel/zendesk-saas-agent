[Unit]
Description=zd-agent (Dify SaaS Zendesk Agent)
After=docker.service network-online.target
Requires=docker.service
Wants=tsh-proxy-db.service

[Service]
Type=simple
Restart=always
RestartSec=30

ExecStartPre=-/usr/bin/docker rm -f zd-agent
# 资源限制：2G 服务器场景 — 800m 硬限 + swap 兜底到 1500m，cpus 0.8
# 如服务器升级到 4G+，可把 --memory 改回 1500m 并移除 --memory-swap
# .tsh 挂载为可写：Teleport 认证中转页需要写入新证书
# /usr/local/bin/tsh 只读挂载：容器内调 tsh login
ExecStart=/usr/bin/docker run --rm --name zd-agent \
    --network host \
    -v /opt/zd-agent/resources:/resources \
    -v /opt/zd-agent/.env:/app/.env:ro \
    -v /opt/zd-agent/code/config.yaml:/app/config.yaml:ro \
    -v /opt/zd-agent/.tsh:/opt/zd-agent/.tsh \
    -v /usr/local/bin/tsh:/usr/local/bin/tsh:ro \
    --memory=800m --memory-swap=1500m --cpus=0.8 \
    --log-driver=journald \
    zd-agent:latest

ExecStop=/usr/bin/docker stop -t 10 zd-agent

[Install]
WantedBy=multi-user.target
