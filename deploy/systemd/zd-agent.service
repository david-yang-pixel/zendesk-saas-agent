[Unit]
Description=zd-agent control plane (manages optional Dify SaaS Agent Worker)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=30

ExecStartPre=-/usr/bin/docker rm -f zd-agent
ExecStartPre=/opt/zd-agent/code/deploy/verify-instance-fence.sh
# 资源限制：2G 服务器场景 — 800m 硬限 + swap 兜底到 1500m，cpus 0.8
# 如服务器升级到 4G+，可把 --memory 改回 1500m 并移除 --memory-swap
ExecStart=/usr/bin/docker run --rm --name zd-agent \
    --network host \
    -v /opt/zd-agent/resources:/opt/zd-agent/resources \
    -v /opt/zd-agent/logs:/opt/zd-agent/logs \
    -v /opt/zd-agent/.env:/app/.env:ro \
    -v /etc/machine-id:/etc/host-machine-id:ro \
    -v /opt/zd-agent/code/config.yaml:/app/config.yaml:ro \
    -v /usr/local/bin/inspector:/usr/local/bin/inspector:ro \
    -v /opt/zd-agent/inspector-config:/opt/zd-agent/inspector-config:ro \
    --memory=800m --memory-swap=1500m --cpus=0.8 \
    -e ZD_AGENT_ENFORCE_INSTANCE_FENCE=1 \
    --log-driver=journald \
    zd-agent:latest

ExecStop=/usr/bin/docker stop -t 50 zd-agent

# Worker cleanup 30s，control-plane supervisor 最多等待 40s；Docker 再留
# 10s，systemd 最外层再留 5s，避免各层同一时刻触发 SIGKILL。
TimeoutStopSec=55

[Install]
WantedBy=multi-user.target
