[Unit]
Description=zd-agent (Dify SaaS Zendesk Agent)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=30

ExecStartPre=-/usr/bin/docker rm -f zd-agent
# 资源限制：2G 服务器场景 — 800m 硬限 + swap 兜底到 1500m，cpus 0.8
# 如服务器升级到 4G+，可把 --memory 改回 1500m 并移除 --memory-swap
ExecStart=/usr/bin/docker run --rm --name zd-agent \
    --network host \
    -v /opt/zd-agent/resources:/opt/zd-agent/resources \
    -v /opt/zd-agent/logs:/opt/zd-agent/logs \
    -v /opt/zd-agent/.env:/app/.env:ro \
    -v /opt/zd-agent/code/config.yaml:/app/config.yaml:ro \
    -v /opt/zd-agent/bin/signoz-mcp-server:/opt/zd-agent/bin/signoz-mcp-server:ro \
    -v /usr/local/bin/inspector:/usr/local/bin/inspector:ro \
    -v /opt/zd-agent/inspector-config:/opt/zd-agent/inspector-config:ro \
    --memory=800m --memory-swap=1500m --cpus=0.8 \
    --log-driver=journald \
    zd-agent:latest

ExecStop=/usr/bin/docker stop -t 35 zd-agent

# 给应用 30s grace（saas_app._on_shutdown 等 in-flight session 收尾）+
# 5s buffer 让 docker 体面退出。原本 10s 太短，aiohttp 没跑完
# on_shutdown → on_cleanup 就被 SIGKILL，造成 RuntimeError: Event loop is closed。
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
