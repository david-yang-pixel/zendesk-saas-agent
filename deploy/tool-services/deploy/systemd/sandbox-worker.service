[Unit]
Description=Sandbox worker MCP service for zd-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tool-services/code
EnvironmentFile=/etc/sandbox-worker/env
Environment=PYTHONPATH=/opt/tool-services/code/src
ExecStart=/opt/tool-services/code/.venv/bin/python -c 'from tool_services.app import main_sandbox; main_sandbox()'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/zd-agent/resources/sandbox

[Install]
WantedBy=multi-user.target
