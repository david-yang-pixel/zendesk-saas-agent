# OpenAI
OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1  # 自定义 API 地址

# Zendesk
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_EMAIL=you@example.com
ZENDESK_API_TOKEN=your-api-token

# GitHub（服务器部署时设置，本地有 SSH key 则无需设置）
# GITHUB_TOKEN=ghp_xxx  # Fine-grained PAT，仓库只读权限即可

# Agent（可选，覆盖 config.yaml 中的值）
# ZD_MAX_CONCURRENT=5
# ZD_MODEL=gpt-4o

# Webhook 鉴权（可选；两者需同时设置）
# ZD_WEBHOOK_AUTH_HEADER=Authorization
# ZD_WEBHOOK_AUTH_VALUE=Bearer difyai123456
