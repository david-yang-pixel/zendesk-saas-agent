# ===== Zendesk =====
ZENDESK_SUBDOMAIN=your-zendesk-subdomain
# agent 以这个 Zendesk 账号身份工作（落款 / @mention 自跳过都基于它）
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=
# SaaS native_messaging 客户可见消息走独立 browser relay MCP，不再使用 Conversations API。
# 例：ZENDESK_BROWSER_RELAY_URL=https://agent.example.com/zendesk-reply-mcp
ZENDESK_BROWSER_RELAY_URL=
ZENDESK_BROWSER_RELAY_API_KEY=
ZENDESK_BROWSER_RELAY_TIMEOUT_SECONDS=90
# Public HTTPS URL called by the remote relay just before Zendesk Send. Do not
# use localhost unless the relay itself runs on this exact host.
ZENDESK_FRESHNESS_CALLBACK_URL=https://agent.example.com/webhook/relay-pre-send-freshness
# Zendesk 读取 / Internal Note / 标签 / 关注走独立 Zendesk MCP；
# public reply 继续走上面的 browser relay。
# 例：ZENDESK_MCP_URL=http://127.0.0.1:8099
ZENDESK_MCP_URL=
ZENDESK_MCP_API_KEY=
ZENDESK_MCP_TIMEOUT_SECONDS=35

# ===== LLM =====
OPENAI_API_KEY=
# (optional) Anthropic fallback
ANTHROPIC_API_KEY=

# ===== Remote MCP Tool Services =====
# GitHub PAT 属于 github-mcp，不放 agent .env。
GITHUB_MCP_URL=
GITHUB_MCP_API_KEY=
GITHUB_MCP_TIMEOUT_SECONDS=35

# 官方文档抓取、llms.txt 缓存和限域访问属于 docs-tool-service。
DOCS_TOOL_SERVICE_URL=
DOCS_TOOL_SERVICE_API_KEY=
DOCS_TOOL_SERVICE_TIMEOUT_SECONDS=35

# 飞书 webhook URL/secret 属于 notification-service，不放 agent .env。
NOTIFICATION_SERVICE_URL=
NOTIFICATION_SERVICE_API_KEY=
NOTIFICATION_SERVICE_TIMEOUT_SECONDS=35

# sandbox 文件读写/搜索/命令执行属于 sandbox-worker。
SANDBOX_WORKER_URL=
SANDBOX_WORKER_API_KEY=
SANDBOX_WORKER_TIMEOUT_SECONDS=65

# ===== SigNoz MCP =====
# Signoz MCP 独立服务负责保存 SIGNOZ_URL / SIGNOZ_API_KEY 并执行 sz。
# zd-agent 只通过远程 Streamable HTTP MCP 调用该服务。
# 例：SIGNOZ_MCP_URL=https://agent.example.com/signoz-mcp
SIGNOZ_MCP_URL=
SIGNOZ_MCP_API_KEY=
SIGNOZ_MCP_TIMEOUT_SECONDS=35

# ===== DB Gateway MCP =====
# DB Gateway 独立服务负责 Teleport / DB proxy / 续期。
# zd-agent 通过远程 Streamable HTTP MCP 调用该服务；只需要网关域名 + API key。
# 例：DB_GATEWAY_URL=https://agent.example.com/db-gateway
DB_GATEWAY_URL=
DB_GATEWAY_API_KEY=

# ===== GitHub repo clone fallback =====
# 仅 legacy 本地 repo clone/saas_branch_switch 可能使用；GitHub PR/Code Search 不使用它。
GITHUB_TOKEN=
