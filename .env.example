# ===== Zendesk =====
ZENDESK_SUBDOMAIN=dify
ZENDESK_EMAIL=saas-bot@dify.ai
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=

# ===== LLM =====
OPENAI_API_KEY=
# (optional) Anthropic fallback
ANTHROPIC_API_KEY=

# ===== Feishu =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFY_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_CHAT_ID=

# ===== Monitoring =====
GRAFANA_API_KEY=
SIGNOZ_API_KEY=

# ===== PostgreSQL =====
# 通常不需要填 — Teleport `tsh proxy db` 走证书认证，psql 不需要密码。
# 仅在以下场景才需要填：
#   - 不走 Teleport，直连 DB（config.yaml 里 postgres.host 改为 DB 地址）
#   - Teleport 代理后 DB 仍要求密码（双重认证，极少见）
PG_PASSWORD=

# ===== GitHub =====
GITHUB_TOKEN=

# ===== Teleport =====
TELEPORT_USER=
