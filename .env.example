# ===== Zendesk =====
ZENDESK_SUBDOMAIN=dify
# agent 以这个 Zendesk 账号身份工作（落款 / @mention 自跳过都基于它）
ZENDESK_EMAIL=yonggang@dify.ai
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=

# ===== LLM =====
OPENAI_API_KEY=
# (optional) Anthropic fallback
ANTHROPIC_API_KEY=

# ===== Feishu =====
# 飞书自定义群机器人（Incoming Webhook 模式）
# 在飞书群 → 群设置 → 群机器人 → 添加 → 自定义机器人 → 复制 webhook URL
FEISHU_WEBHOOK_URL=
# 可选：若创建机器人时启用"加签"，把签名密钥填这里
FEISHU_WEBHOOK_SECRET=

# ===== Monitoring =====
GRAFANA_API_KEY=
SIGNOZ_API_KEY=

# ===== PostgreSQL =====
# 通常不需要填 — Teleport `tsh proxy db` 走证书认证，psql 不需要密码。
# 仅在以下场景才需要填：
#   - 不走 Teleport，直连 DB（config.yaml 里 postgres.host 改为 DB 地址）
#   - Teleport 代理后 DB 仍要求密码（双重认证，极少见）
PG_PASSWORD=

# ===== GitHub =====
GITHUB_TOKEN=

# ===== Teleport =====
TELEPORT_USER=
