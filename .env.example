# ===== Zendesk =====
ZENDESK_SUBDOMAIN=your-zendesk-subdomain
# agent 以这个 Zendesk 账号身份工作（落款 / @mention 自跳过都基于它）
ZENDESK_EMAIL=agent@example.com
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=
# SaaS native_messaging 客户可见消息走独立 browser relay，不再使用 Conversations API。
# 例：ZENDESK_BROWSER_RELAY_URL=http://127.0.0.1:8097
ZENDESK_BROWSER_RELAY_URL=
ZENDESK_BROWSER_RELAY_API_KEY=
ZENDESK_BROWSER_RELAY_TIMEOUT_SECONDS=90
# Zendesk 读取 / Internal Note / 标签 / 关注走独立 Zendesk MCP；
# public reply 继续走上面的 browser relay。
# 例：ZENDESK_MCP_URL=http://127.0.0.1:8099
ZENDESK_MCP_URL=
ZENDESK_MCP_API_KEY=
ZENDESK_MCP_TIMEOUT_SECONDS=35

# ===== LLM =====
OPENAI_API_KEY=
# (optional) Anthropic fallback
ANTHROPIC_API_KEY=

# ===== Feishu =====
# 飞书自定义群机器人（Incoming Webhook 模式）
# 在飞书群 → 群设置 → 群机器人 → 添加 → 自定义机器人 → 复制 webhook URL
FEISHU_WEBHOOK_URL=
# 可选：若创建机器人时启用"加签"，把签名密钥填这里
FEISHU_WEBHOOK_SECRET=

# ===== SigNoz MCP =====
# Signoz MCP 独立服务负责保存 SIGNOZ_URL / SIGNOZ_API_KEY 并执行 sz。
# zd-agent 只通过远程 Streamable HTTP MCP 调用该服务。
# 例：SIGNOZ_MCP_URL=https://agent.example.com/signoz-mcp
SIGNOZ_MCP_URL=
SIGNOZ_MCP_API_KEY=
SIGNOZ_MCP_TIMEOUT_SECONDS=35

# ===== DB Gateway MCP =====
# DB Gateway 独立服务负责 Teleport / DB proxy / 续期。
# zd-agent 通过远程 Streamable HTTP MCP 调用该服务；只需要网关域名 + API key。
# 例：DB_GATEWAY_URL=https://agent.example.com/db-gateway
DB_GATEWAY_URL=
DB_GATEWAY_API_KEY=

# ===== GitHub =====
GITHUB_TOKEN=
